# Release location for scripts/flash.sh.
#
# The bucket is public — this is soft-launched, unsupported, out of a personal repo. There is nothing to
# hide: flash.sh has to fetch from here, so the URL lives here and `flash.sh /dev/sdX` works with no
# extra arguments. The signed CHECKSUM + the pinned-fingerprint check are what make the bytes trustworthy,
# not the secrecy of the URL.
RELEASE_BASE_URL=https://storage.googleapis.com/spark-rocky
