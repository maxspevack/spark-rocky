# serving-images.env — the vLLM serving images behind the shipped parity receipts, pinned by digest. (#28)
#
# WHY THIS FILE EXISTS: spark-arena pins no vLLM version, and spark-vllm-docker compiles the LATEST vLLM at
# image-build time. So "rebuild the serving image" floats the whole runtime forward and silently changes the
# benchmark surface. The 2026-06-14 GB10 forum sweep documented two breakages this float walks straight into:
#   - FastAPI >= 0.137 breaks vLLM /v1/models   (forum t/373314). Our images are pinned-in-time at 0.136.3.
#   - FlashInfer < 0.6.13 lacks the GB10 cubins and JIT-deadlocks NVFP4 (forum t/373274). Ours carry 0.6.13.
# A regression-vs-self comparison is only honest against a pinned image. The M4 rebuild-validate diffs a fresh
# build against these coordinates; any drift is a finding to read, not a silent number.
#
# Provenance: all built ON the Spark (GB10) from spark-vllm-docker @ 8b6347d (upstream eugr HEAD, 2026-06-07),
# digests captured 2026-06-14. RepoDigests are local (containerd) content digests — stable verify identifiers.

SPARK_VLLM_DOCKER_COMMIT=8b6347d4281efeb444a938513499d5d015bc95c3   # upstream eugr HEAD, 2026-06-07 "Bugfix"

# --- vllm-node (stock) — behind receipts: Qwen3.5-0.8B (0.96x), LFM2.5-350M ---
VLLM_NODE_DIGEST=sha256:b3db58e0af07318a5b398c950bea5a6c64244d34be7e112fd62fc1e728a69361
VLLM_NODE_VLLM=0.22.1rc1.dev268+gfa662b1a8.d20260608
VLLM_NODE_FASTAPI=0.136.3
VLLM_NODE_FLASHINFER=0.6.13
VLLM_NODE_TORCH=2.11.0+cu130
VLLM_NODE_TRANSFORMERS=5.10.2
VLLM_NODE_TRITON=3.6.0

# --- vllm-node-tf5 (--tf5, transformers>=5) — behind receipts: Qwen3.5-35B-A3B-FP8 (1.01x, headline), gemma-3-1b-it (1.05x) ---
VLLM_NODE_TF5_DIGEST=sha256:b06cdd392d749b1751d156389c240753239e38656a813767fdb9df9c44ced166
VLLM_NODE_TF5_VLLM=0.22.1rc1.dev330+g6deb05e0e.d20260610
VLLM_NODE_TF5_FASTAPI=0.136.3
VLLM_NODE_TF5_FLASHINFER=0.6.13
VLLM_NODE_TF5_TORCH=2.11.0+cu130
VLLM_NODE_TF5_TRANSFORMERS=5.11.0
VLLM_NODE_TF5_TRITON=3.6.0

# --- generation 2: the dgx-vllm permanent mirror (#71) — adopted 2026-07-24 ---
# spark-arena/dgx-vllm mirrors eugr's nightlies under permanent dated tags; build-index.json + the
# in-image dev.sparkrun.* labels map tag -> exact vLLM/FlashInfer coordinates. This kills the
# "spark-arena pins no vLLM version" confound for our receipts: a receipt names a tag any third party
# pulls byte-identically. The June generation above STAYS — it backs the shipped parity receipts and
# remains the regression-vs-self baseline. Upstream's --tf5 lineage collapsed (deprecated alias,
# identical digest), so ONE image now serves where vllm-node/vllm-node-tf5 split before.
# Digest cross-verified 2026-07-23 from two independent sources: build-index.json == live ghcr manifest.

SERVING_IMAGE_TAG=2026072302   # drift-checked (#24 SERVING row): INFO under 31 days, DRIFT past a month
SERVING_IMAGE=ghcr.io/spark-arena/dgx-vllm-eugr-nightly:2026072302
SERVING_IMAGE_DIGEST=sha256:200979f304bfc688a4ed1f00895c6a22c2372065837f79de65dd35b5b4a446ef
SERVING_SOURCE_DIGEST=sha256:a45f994d6c1faa943f08901adbf534daac559bc5c906b06a1f6cd0aa9eb295ee  # eugr/spark-vllm:nightly-20260723
SERVING_SVD_COMMIT=4851a0965c1d4eba4934f6f23508134583160d32   # spark-vllm-docker commit the image was built from
SERVING_VLLM=0.23.1rc1.dev1408+ga354a9055.d20260723
SERVING_FLASHINFER=0.6.15      # > 0.6.13, GB10 cubins present (t/373274 class cleared)
SERVING_FASTAPI=0.136.3        # still below the 0.137 /v1/models breakage (t/373314) — pinned in-image upstream
SERVING_TORCH=2.11.0+cu130
SERVING_TRANSFORMERS=5.14.1
SERVING_TRITON=3.6.0

# --- vllm-node-mxfp4 (exploratory; NOT behind any shipped parity receipt) ---
VLLM_NODE_MXFP4_DIGEST=sha256:66c1a1e81a29dd158e8687cbbfc0190d52889c1aa578e3575766be00355c96ec
VLLM_NODE_MXFP4_VLLM=0.1.dev12770+g045293d82.d20260611.cu131
VLLM_NODE_MXFP4_FASTAPI=0.136.3
VLLM_NODE_MXFP4_TORCH=2.10.0a0+a36e1d39eb.nv26.1.42222806
