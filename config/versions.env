# versions.env — the pinned versions for the spark-rocky build.
# Bump here to stay current, then rebuild 01->04 and re-verify (see docs/build/build.md).
KVER=6.18.35
DRIVER_VER=610.43.02
ROCKY_RELEASEVER=10
# Page size: an OPINIONATED, PINNED choice. 64k is our default for the GB10 concurrent AI-serving workload
# (measurable win on concurrent + deep-context cells; rationale + data in docs/build/platform-deltas.md).
# Build 4k by flipping this pin. The scripts derive the kernel release (KREL = $KVER, plus a -64k LOCALVERSION
# suffix when 64k) right after they source this file -- kept out of here so this stays a plain, Makefile-
# includable pin file (Make cannot parse a shell conditional).
PAGE_SIZE=64k
# SHA256 of linux-$KVER.tar.xz from kernel.org's signed sha256sums.asc. 01-build-kernel.sh
# verifies the downloaded tarball against this before building. Update when bumping KVER.
KERNEL_SHA256=f78602932219125e211c5f5bfd84edcfd4ec5ce88fc944f8248413f665bef236
