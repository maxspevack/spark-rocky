# versions.env — the pinned versions for the spark-rocky build.
# Bump here to stay current, then rebuild 01->04 and re-verify (see docs/build/build.md).

# Kernel SOURCE selector -- the which-kernel knob, so a build can A/B different kernels + configs.
#   kernelorg = stock kernel.org tarball (the v-major path 6.x / 7.x is derived from KVER).
#   clk       = CIQ CLK source (NOT wired yet -- tracked in #52; needs source-fetch + release discovery).
KERNEL_SOURCE=kernelorg
KCONFIG=config/rocky-6.18.34-gb10.config   # base .config (repo-relative); carries forward to KVER via olddefconfig. Point elsewhere to A/B another config.
KVER=6.18.35
DRIVER_VER=610.43.02
ROCKY_RELEASEVER=10
# Page size: an OPINIONATED, PINNED choice. 64k is our default for the GB10 concurrent AI-serving workload
# (measurable win on concurrent + deep-context cells; rationale + data in docs/build/platform-deltas.md).
# Build 4k by flipping this pin. The page size is a kernel CONFIG choice (CONFIG_ARM64_64K_PAGES), NOT a
# uname decoration: the kernel release stays plain $KVER (uname -r = 6.18.35) either way. 64k is proven by
# the config symbol + getconf PAGESIZE + the provenance stamp, and gated fail-closed in 05 -- not by a suffix.
PAGE_SIZE=64k
# SHA256 of linux-$KVER.tar.xz from kernel.org's signed sha256sums.asc. 01-build-kernel.sh
# verifies the downloaded tarball against this before building. Update when bumping KVER.
KERNEL_SHA256=f78602932219125e211c5f5bfd84edcfd4ec5ce88fc944f8248413f665bef236
